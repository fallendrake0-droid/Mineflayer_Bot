lib/api-spec/openapi.yaml
content":"openapi: 3.1.0
info:
  title: Api
  version: 0.2.0
  description: Extended API specification for Mineflayer bot and AI assistant operations
servers:
  - url: /api
    description: Base API path
tags:
  - name: health
    description: Health operations
  - name: bot
    description: Minecraft bot operations
  - name: ai
    description: AI assistant operations
paths:
  /healthz:
    get:
      operationId: healthCheck
      tags: [health]
      summary: Health check
      responses:
        "200":
          description: Healthy
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/HealthStatus"

  /bot/connect:
    post:
      operationId: connectBot
      tags: [bot]
      summary: Connect bot to a Minecraft server
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/BotConnectRequest"
      responses:
        "200":
          description: Bot connected
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/BotStatus"

  /bot/status:
    get:
      operationId: getBotStatus
      tags: [bot]
      summary: Get current bot status
      responses:
        "200":
          description: Current bot status
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/BotStatus"

  /bot/context:
    get:
      operationId: getBotContext
      tags: [bot]
      summary: Get bot context snapshot for AI planning
      responses:
        "200":
          description: Bot context snapshot
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/BotContextSnapshot"

  /bot/metrics:
    get:
      operationId: getBotMetrics
      tags: [bot]
      summary: Get bot runtime metrics
      responses:
        "200":
          description: Bot metrics
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/BotMetrics"

  /bot/task/start:
    post:
      operationId: startBotTask
      tags: [bot]
      summary: Start a bot task from a high-level action
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/BotTaskRequest"
      responses:
        "200":
          description: Task started
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/CommandResponse"

  /bot/command:
    post:
      operationId: executeBotCommand
      tags: [bot]
      summary: Execute a bot command
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/BotCommandRequest"
      responses:
        "200":
          description: Command accepted
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/CommandResponse"

  /ai/providers:
    get:
      operationId: getAIProviders
      tags: [ai]
      summary: List configured AI providers
      responses:
        "200":
          description: AI provider status
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/AIProviderListResponse"

  /ai/chat:
    post:
      operationId: chatWithAI
      tags: [ai]
      summary: Send a text prompt to the active AI provider
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/AIChatRequest"
      responses:
        "200":
          description: AI response
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/AIResponse"

  /ai/plan:
    post:
      operationId: generateAIPlan
      tags: [ai]
      summary: Generate a task plan for the bot
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/AIPlanRequest"
      responses:
        "200":
          description: AI plan result
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/AIPlanResponse"

  /ai/decision:
    post:
      operationId: makeAIDecision
      tags: [ai]
      summary: Produce the best next bot action from current context
      responses:
        "200":
          description: Decision result
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/AIDecisionResponse"

components:
  schemas:
    HealthStatus:
      type: object
      properties:
        status:
          type: string
      required: [status]

    Position:
      type: object
      properties:
        x:
          type: number
        y:
          type: number
        z:
          type: number
      required: [x, y, z]

    LogEntry:
      type: object
      properties:
        timestamp:
          type: string
        level:
          type: string
        message:
          type: string
      required: [timestamp, level, message]

    InventoryItem:
      type: object
      properties:
        name:
          type: string
        count:
          type: integer
        slot:
          type: integer
        isArmor:
          type: boolean
        isTool:
          type: boolean
      required: [name, count, slot, isArmor, isTool]

    BotConnectRequest:
      type: object
      properties:
        host:
          type: string
        port:
          type: integer
          default: 25565
        username:
          type: string
        version:
          type: string
          default: "1.20.1"
      required: [host, username]

    BotStatus:
      type: object
      properties:
        connected:
          type: boolean
        username:
          type: string
        host:
          type: string
        currentTask:
          type: string
        health:
          type: number
        food:
          type: number
        position:
          $ref: "#/components/schemas/Position"
        players:
          type: array
          items:
            type: string
        version:
          type: string
      required: [connected]

    BotContextSnapshot:
      type: object
      properties:
        connected:
          type: boolean
        username:
          type: string
        currentTask:
          type: string
        health:
          type: number
          nullable: true
        food:
          type: number
          nullable: true
        position:
          $ref: "#/components/schemas/Position"
        players:
          type: array
          items:
            type: string
        inventory:
          type: array
          items:
            $ref: "#/components/schemas/InventoryItem"
        recentLogs:
          type: array
          items:
            $ref: "#/components/schemas/LogEntry"
        timestamp:
          type: string
      required: [connected, username, currentTask, position, players, inventory, recentLogs, timestamp]

    BotMetrics:
      type: object
      properties:
        connected:
          type: boolean
        logging:
          type: object
          properties:
            totalLogs:
              type: integer
            maxLogs:
              type: integer
        currentTask:
          type: string
        miningActive:
          type: boolean
        botVersion:
          type: string
          nullable: true
        players:
          type: integer
        health:
          type: number
          nullable: true
        food:
          type: number
          nullable: true
      required: [connected, logging, currentTask, miningActive, players]

    BotTaskRequest:
      type: object
      properties:
        task:
          type: string
          enum: [follow, stop, killMobs, mine, dropItems, buildBase, climb, hit, pullLever, hitPlayer, chopTree]
        target:
          type: string
        resource:
          type: string
        treeType:
          type: string
      required: [task]

    BotCommandRequest:
      type: object
      properties:
        command:
          type: string
        target:
          type: string
        resource:
          type: string
        treeType:
          type: string
      required: [command]

    CommandResponse:
      type: object
      properties:
        success:
          type: boolean
        message:
          type: string
      required: [success, message]

    AIProviderConfig:
      type: object
      properties:
        name:
          type: string
        enabled:
          type: boolean
        defaultModel:
          type: string
      required: [name, enabled, defaultModel]

    AIProviderListResponse:
      type: object
      properties:
        providers:
          type: array
          items:
            $ref: "#/components/schemas/AIProviderConfig"
      required: [providers]

    AIChatRequest:
      type: object
      properties:
        prompt:
          type: string
        provider:
          type: string
        model:
          type: string
        temperature:
          type: number
        maxTokens:
          type: integer
        context:
          type: object
      required: [prompt]

    AIResponse:
      type: object
      properties:
        provider:
          type: string
        model:
          type: string
        text:
          type: string
        usedFallback:
          type: boolean
      required: [provider, model, text, usedFallback]

    AIPlanRequest:
      type: object
      properties:
        objective:
          type: string
        provider:
          type: string
        model:
          type: string
        context:
          type: object
      required: [objective]

    AIPlanResponse:
      type: object
      properties:
        provider:
          type: string
        model:
          type: string
        plan:
          type: array
          items:
            type: string
        usedFallback:
          type: boolean
      required: [provider, model, plan, usedFallback]

    AIDecisionResponse:
      type: object
      properties:
        provider:
          type: string
        model:
          type: string
        action:
          type: string
        rationale:
          type: string
        confidence:
          type: number
        usedFallback:
          type: boolean
      required: [provider, model, action, rationale, confidence, usedFallback]

    ErrorResponse:
      type: object
      properties:
        error:
          type: string
      required: [error]

