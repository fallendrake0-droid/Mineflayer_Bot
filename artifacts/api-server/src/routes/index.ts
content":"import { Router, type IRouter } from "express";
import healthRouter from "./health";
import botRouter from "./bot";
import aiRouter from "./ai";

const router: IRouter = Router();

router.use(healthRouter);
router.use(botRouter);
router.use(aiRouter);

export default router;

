import { Router } from "express";
import { botManager } from "../lib/bot";
import { aiService } from "../lib/ai";

const router = Router();

router.get("/ai/providers", (_req, res) => {
  res.json({ providers: aiService.getProviders() });
});

router.get("/ai/status", (_req, res) => {
  res.json({
    providers: aiService.getProviders(),
    defaultProvider: (process.env["AI_PROVIDER"] ?? "local").toLowerCase(),
    ready: true,
  });
});

router.post("/ai/chat", async (req, res) => {
  const prompt = typeof req.body?.prompt === "string" ? req.body.prompt : "";
  if (!prompt.trim()) {
    res.status(400).json({ error: "prompt is required" });
    return;
  }

  try {
    const result = await aiService.chat(prompt, {
      provider: req.body?.provider,
      model: req.body?.model,
      temperature: req.body?.temperature,
      maxTokens: req.body?.maxTokens,
      context: {
        bot: botManager.getContextSnapshot(),
        request: req.body?.context ?? {},
      },
    });
    res.json(result);
  } catch (err: unknown) {
    res.status(500).json({ error: err instanceof Error ? err.message : String(err) });
  }
});

