# Required to access protected bot-control API endpoints and dashboard WebSocket.
# Generate a unique secret, for example: openssl rand -hex 32
DASHBOARD_TOKEN=replace-with-a-unique-random-secret-at-least-32-characters

# Optional: comma-separated exact browser origins if the dashboard is hosted
# on a different origin. Leave empty for same-origin use only.
DASHBOARD_ORIGINS=

# Optional: comma-separated exact Minecraft usernames and/or UUIDs allowed
# to issue bot commands through in-game chat. Empty means deny all chat commands.
MINEFLAYER_COMMAND_ALLOWLIST=

# API server port (defaults to 3000 in the API server).
PORT=3000

# Optional AI provider settings. Core bot functions should remain usable without AI.
AI_PROVIDER=local
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
