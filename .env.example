# Required to access protected bot-control API endpoints and dashboard WebSocket.
# Generate a unique secret, for example: openssl rand -hex 32
DASHBOARD_TOKEN=replace-with-a-unique-random-secret-at-least-32-characters

# Optional: comma-separated exact browser origins if the dashboard is hosted
# on a different origin. Leave empty for same-origin use only.
DASHBOARD_ORIGINS=

# Optional frontend BUILD-TIME setting for a separately hosted API:
# Configure VITE_API_BASE_URL in the dashboard build environment, e.g.
# VITE_API_BASE_URL=https://api.example.com
# This value is public (never put API keys or other secrets in VITE_ variables).

# Optional: comma-separated exact Minecraft usernames and/or UUIDs allowed
# to issue bot commands through in-game chat. Empty means deny all chat commands.
MINEFLAYER_COMMAND_ALLOWLIST=

# API server port (defaults to 3000 in the API server).
PORT=3000

# AI provider: local, openai, gemini, anthropic, or ollama.
AI_PROVIDER=local
# Optional global model override. Provider-specific *_MODEL values take precedence.
# AI_MODEL=

# OpenAI API. Use Responses for official OpenAI API; use chat-completions for
# OpenAI-compatible endpoints which implement /chat/completions only.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_API_MODE=responses
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_REASONING_EFFORT=none

# Google Gemini API
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Anthropic Claude API
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Local Ollama / OpenAI-compatible endpoint
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Per-request remote AI timeout. Accepted range: 1000-120000 ms.
AI_TIMEOUT_MS=15000
